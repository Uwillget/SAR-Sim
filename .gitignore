# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/
/.vscode/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
/Builds/
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
# Runtime simulation output — not distributed with the repository
# Contains generated data (SimulationRecording.json, OccupancyLog.json, MetricsTable.csv,
# BatchExperimentRunSummaryTable.csv, Trajectories/) and visualisation scripts with their
# derived figures (Visualization/).
/[Oo]utput/

# Test/development scenes — not for distribution
/[Aa]ssets/Resources/Scenes/SampleScene.unity
/[Aa]ssets/Resources/Scenes/SampleScene.unity.meta

# Screenshots — local reference images, not for distribution
/[Aa]ssets/Screenshots/
/[Aa]ssets/Screenshots.meta
/OperationGuide/QuickStart/Images/raw/
/QA/
/QA_Captures/
/TestResults/
/Tools/SARPlotWorker/build/
/Tools/SARPlotWorker/dist/
/Tools/SARPlotWorker/*.spec
__pycache__/
*.py[cod]
/[Aa]ssets/ImportedCityModels/
/[Aa]ssets/ImportedCityModels.meta

# Large machine-local authoring scene. It is rebuilt from the imported city model
# and is not needed to open, run, or build the shipped application.
/[Aa]ssets/Resources/Scenes/ShenzhenSKPWhitebox.unity
/[Aa]ssets/Resources/Scenes/ShenzhenSKPWhitebox.unity.meta
/[Aa]ssets/Resources/Scenes/ShenzhenHullWhitebox.unity
/[Aa]ssets/Resources/Scenes/ShenzhenHullWhitebox.unity.meta
[Uu]e_import/

# Joint-simulation runtime artefacts: the per-frame diagnostic log and the saved
# camera-follow state are produced locally on every run.
/JointSimulation/airsim_bridge/bridge_diag.csv
/JointSimulation/airsim_bridge/follow_camera.json
/JointSimulation/follow_camera.json
/JointSimulation/*.csv
/JointSimulation/*.log

# Unreal host project. Only the .uproject, Config and Content are tracked; the
# plugin, derived data and build output are supplied by the user.
/UnrealHost/**/Binaries/
/UnrealHost/**/DerivedDataCache/
/UnrealHost/**/Intermediate/
/UnrealHost/**/Saved/
/UnrealHost/**/Plugins/AirSim/
/UnrealHost/**/.vs/
/UnrealHost/**/*.sln
/UnrealHost/**/*.suo

# Legacy documentation captures superseded by the English Quick Start.
/Documentation/
/OperationGuide/0*.png

# Portable-player runtime state. These folders are created beside the executable
# and must never be committed when a build is tested inside a working copy.
/SARScenes/
/SARData/
/Network/
/Settings/
/ImportCache/
/.legacy-local-low-migrated-v1
/cone-inward-exe.png

# Research outputs are published separately when needed, never as source assets.
# These directory names cover legacy/local experiment layouts outside Output/.
/SimulationData/
/ExperimentalData/
/ExperimentData/
/PlotScripts/
/Plotting/
/Visualization/
/Figures/
/*.zip

# Claude Code — personal AI tool configuration, not for distribution
/.claude/
